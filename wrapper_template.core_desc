// ETISS CoreDesc wrapper template
//
// Imports the necessary RISC-V CoreDSL specs along with a specific
// extension to specify the core sufficiently for building with ETISS

import "CoreDSL-Instruction-Set-Description/RISCVBase.core_desc"
import "CoreDSL-Instruction-Set-Description/RV32I.core_desc"
import "CoreDSL-Instruction-Set-Description/RVM.core_desc"
import "CoreDSL-Instruction-Set-Description/RVC.core_desc"
import "tum_mod.core_desc"
import "tum_rva.core_desc"
import "tum_rvm.core_desc"

import "${SEAL5_COREDSL_PATH}"

Core RV32IX${SEAL5_EXTN} provides RV32I, RV32IC, Zifencei, RV32M, X${SEAL5_EXTN}, tum_csr, tum_ret, tum_semihosting {
    architectural_state {
        XLEN=32;
        // definitions for the architecture wrapper
        //                    XL    ZYXWVUTSRQPONMLKJIHGFEDCBA
        unsigned int MISA_VAL = 0b01000000100100000011000100000100;
        unsigned int MARCHID_VAL = 0x80000003;
    }
}
